{
  "name": "@botiverse/hands-electron",
  "version": "0.3.0",
  "description": "Hands for Electron apps — Crashpad crash reporting (main + renderer) and macOS update patches for electron-updater.",
  "author": {
    "name": "jiacheng",
    "email": "jiacheng@botiverse.dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/botiverse/hands.git",
    "directory": "clients/electron"
  },
  "type": "module",
  "exports": {
    "./main": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "import": "./dist/renderer.js"
    },
    "./preload": {
      "types": "./dist/preload.d.ts",
      "import": "./dist/preload.js"
    },
    "./updater": {
      "types": "./dist/updater/index.d.ts",
      "import": "./dist/updater/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:patch": "node smoke/patch-smoke.mjs"
  },
  "dependencies": {
    "@botiverse/hands-app-patch": "workspace:*"
  },
  "peerDependencies": {
    "electron": ">=22",
    "electron-updater": ">=6.3.9 <7"
  },
  "peerDependenciesMeta": {
    "electron-updater": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron-updater": "6.8.11",
    "electron-updater-6.3.9": "npm:electron-updater@6.3.9",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
