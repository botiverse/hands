{
  "name": "@botiverse/hands-feedback-react",
  "version": "0.1.0",
  "description": "Embeddable reporter-facing Hands feedback inbox components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/botiverse/hands.git"
  },
  "type": "module",
  "main": "dist/index.js",
