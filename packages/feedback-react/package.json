{
  "name": "@botiverse/hands-feedback-react",
  "version": "0.5.4",
  "description": "Embeddable reporter-facing Hands feedback inbox components.",
  "author": {
    "name": "jiacheng",
    "email": "jiacheng@botiverse.dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/botiverse/hands.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./source": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./source/styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.tsx",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-styles.mjs",
    "test": "vitest run",
    "test:browser": "node test-browser/alignment.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@botiverse/raft-ui": ">=0.20.0 <1.0.0",
    "lucide-react": ">=0.575.0 <2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@botiverse/raft-ui": "0.95.0",
    "@botiverse/raft-ui-legacy": "npm:@botiverse/raft-ui@0.20.0",
    "@tailwindcss/cli": "4.3.2",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "0.28.1",
    "jsdom": "^26.1.0",
    "lucide-react": "^1.23.0",
    "playwright": "1.64.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "4.3.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  }
}
