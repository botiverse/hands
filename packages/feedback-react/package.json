    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "raft-ui": ">=0.0.18",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "raft-ui": "^0.0.18",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
